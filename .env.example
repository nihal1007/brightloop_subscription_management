# PostgreSQL Database Connection
# Default local portable PostgreSQL runner or standard PostgreSQL instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/brightloop?schema=public"

# Authentication Session Secret (Generate with: openssl rand -base64 32)
AUTH_SECRET="brightloop-super-secure-production-jwt-secret-key-change-in-prod-2026"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional AI Assistant configuration (Google Gemini or OpenAI API key)
# If left empty, Brightloop automatically operates in verified deterministic rule-based insights mode.
GEMINI_API_KEY=""

# Optional Email Service Provider (e.g. Resend, Sendgrid, SMTP)
# Used for password reset and invoice dispatch. If not configured, notifications are delivered in-app.
EMAIL_SERVER=""
EMAIL_FROM="billing@brightloop.io"
